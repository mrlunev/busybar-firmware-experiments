{
  "title": "World Clock",
  "description": "Dual timezone clock with daylight-saving time support",
  "layout": "columns",
  "fields": [
    {
      "key": "city_1_name",
      "type": "text",
      "label": "City 1 Name",
      "placeholder": "London",
      "maxLength": 10,
      "default": "London"
    },
    {
      "key": "city_2_name",
      "type": "text",
      "label": "City 2 Name",
      "placeholder": "Moscow",
      "maxLength": 10,
      "default": "Moscow"
    },
    {
      "key": "city_1_tz",
      "type": "select",
      "label": "City 1 Timezone",
      "default": "London",
      "optionsSource": {
        "endpoint": "/api/time/tzlist",
        "itemsPath": "list",
        "valueKey": "name",
        "labelKey": "name",
        "labelTemplate": "UTC{offset}, {name}"
      }
    },
    {
      "key": "city_2_tz",
      "type": "select",
      "label": "City 2 Timezone",
      "default": "Moscow",
      "optionsSource": {
        "endpoint": "/api/time/tzlist",
        "itemsPath": "list",
        "valueKey": "name",
        "labelKey": "name",
        "labelTemplate": "UTC{offset}, {name}"
      }
    }
  ]
}
